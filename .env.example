# Required for: kaldrax run
KALDRAX_API_KEY=replace-me
KALDRAX_MODEL=your-executor-model
KALDRAX_EVALUATOR_MODEL=your-different-evaluator-model

# Optional OpenAI-compatible provider configuration
KALDRAX_BASE_URL=https://api.openai.com/v1
KALDRAX_TIMEOUT_SECONDS=60
KALDRAX_MAX_TOKENS=2048
KALDRAX_TOKEN_PARAMETER=max_completion_tokens
