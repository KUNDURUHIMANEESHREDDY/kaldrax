# Required for hosted providers only; loopback Ollama does not need a key.
KALDRAX_API_KEY=replace-me
KALDRAX_MODEL=your-builder-model
KALDRAX_EVALUATOR_MODEL=your-different-evaluator-model

# Required for: kaldrax team and kaldrax validate-live
KALDRAX_PLANNER_MODEL=your-planner-model
KALDRAX_REVIEWER_MODEL=your-reviewer-model

# Optional OpenAI-compatible provider configuration
KALDRAX_BASE_URL=https://api.openai.com/v1
KALDRAX_TIMEOUT_SECONDS=60
KALDRAX_MAX_TOKENS=2048
# Ollama/local OpenAI-compatible servers typically use max_tokens instead.
KALDRAX_TOKEN_PARAMETER=max_completion_tokens
# Local Ollama example (uncomment and set model names you have pulled):
# KALDRAX_BASE_URL=http://127.0.0.1:11434/v1
# KALDRAX_MODEL=qwen3:8b
# KALDRAX_EVALUATOR_MODEL=qwen3:4b
# KALDRAX_TOKEN_PARAMETER=max_tokens

# Optional hosted semantic embeddings (OpenAI-compatible HTTPS API; no local model)
# KALDRAX_EMBEDDING_MODEL=text-embedding-3-small
# KALDRAX_EMBEDDING_API_KEY= (defaults to KALDRAX_API_KEY)
# KALDRAX_EMBEDDING_BASE_URL=https://api.openai.com/v1
# KALDRAX_EMBEDDING_TIMEOUT_SECONDS=30

# Optional per-run provider budgets (shared across all model roles)
KALDRAX_MAX_PROVIDER_CALLS=20
KALDRAX_MAX_RUN_INPUT_TOKENS=60000
KALDRAX_MAX_RUN_OUTPUT_TOKENS=12000
KALDRAX_MAX_RUN_TOTAL_TOKENS=72000
KALDRAX_MAX_RUN_DURATION_SECONDS=600

# Optional estimated monetary ceiling; configure rates for the most expensive model used
# KALDRAX_MAX_RUN_COST_USD=0.25
# KALDRAX_INPUT_COST_PER_MILLION_USD=2.00
# KALDRAX_OUTPUT_COST_PER_MILLION_USD=8.00

# Required for: kaldrax team
# KALDRAX_PLANNER_MODEL=your-planner-model
# KALDRAX_REVIEWER_MODEL=your-reviewer-model

# Optional: pre-pulled Docker image for repository verification (must contain Python and test dependencies)
# docker pull python:3.13-slim
# KALDRAX_SANDBOX_IMAGE=python:3.13-slim
